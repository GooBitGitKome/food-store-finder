# ==========================================
# Food Store Finder Backend Configuration
# ==========================================

PROJECT_NAME="Food Store Finder"
API_V1_PREFIX="/api/v1"

# CORS許可オリジン (カンマ区切り、または "*" で全許可)
# 例: "https://food-store-finder.pages.dev,http://localhost:3000"
CORS_ORIGINS="*"

# 外部API設定
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org/search"
USER_AGENT="FoodStoreFinderApp/1.0 (contact: developer@foodstorefinder.org)"
REQUEST_TIMEOUT=120.0
